{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "XC2 Recomp",
  "repo": "AksharDP/xc2-recomp",
  "inputs": [
    {
      "id": "base",
      "label": "Your Xenoblade Chronicles 2 base game: its .nsp or .xci (either release: Americas and Europe, or Japan).",
      "role": "game",
      "formats": [{ "type": "file", "extensions": ["nsp", "xci"], "requires": ["keys"] }]
    },
    {
      "id": "update",
      "label": "The game's last update (3.0.1; 3.0.0 for the Japanese release), an .nsp of the same release as the base game.",
      "role": "update",
      "formats": [{ "type": "file", "extensions": ["nsp"], "requires": ["keys"] }]
    },
    { "id": "keys", "label": "Your Nintendo Switch prod.keys", "role": "key", "shared": "switch.prod-keys" },
    {
      "id": "dlc1",
      "label": "Expansion Pass pack 1 (.nsp)",
      "role": "dlc",
      "optional": true,
      "formats": [{ "type": "file", "extensions": ["nsp"], "requires": ["keys"] }]
    },
    {
      "id": "dlc2",
      "label": "Expansion Pass pack 2 (.nsp)",
      "role": "dlc",
      "optional": true,
      "formats": [{ "type": "file", "extensions": ["nsp"], "requires": ["keys"] }]
    },
    {
      "id": "dlc3",
      "label": "Expansion Pass pack 3 (.nsp)",
      "role": "dlc",
      "optional": true,
      "formats": [{ "type": "file", "extensions": ["nsp"], "requires": ["keys"] }]
    },
    {
      "id": "dlc4",
      "label": "Expansion Pass pack 4 (.nsp)",
      "role": "dlc",
      "optional": true,
      "formats": [{ "type": "file", "extensions": ["nsp"], "requires": ["keys"] }]
    },
    {
      "id": "dlc5",
      "label": "Expansion Pass pack 5 (.nsp)",
      "role": "dlc",
      "optional": true,
      "formats": [{ "type": "file", "extensions": ["nsp"], "requires": ["keys"] }]
    },
    {
      "id": "dlc6",
      "label": "Expansion Pass pack 6 (.nsp)",
      "role": "dlc",
      "optional": true,
      "formats": [{ "type": "file", "extensions": ["nsp"], "requires": ["keys"] }]
    },
    {
      "id": "torna",
      "label": "Torna ~ The Golden Country (.nsp)",
      "role": "dlc",
      "optional": true,
      "formats": [{ "type": "file", "extensions": ["nsp"], "requires": ["keys"] }]
    }
  ],
  "prepare": {
    "program": ["python/python.exe", "XC2-Setup.AppImage"],
    "args": [
      "-m", "installer", "--progress-lines",
      "--base={input:base}",
      "--update={input:update}",
      "--keys={input:keys}",
      "--dlc={input:dlc1}",
      "--dlc={input:dlc2}",
      "--dlc={input:dlc3}",
      "--dlc={input:dlc4}",
      "--dlc={input:dlc5}",
      "--dlc={input:dlc6}",
      "--dlc={input:torna}",
      "--dest={install}/game"
    ],
    "label": "Building the game from your files (about 10 minutes, and about 25 GB of free space while it runs)",
    "timeout": 7200
  },
  "start": {
    "program": ["game/xc2.exe", "game/xc2"]
  },
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": [{ "path": "{install}/game/xc2.ini" }]
    }
  ],
  "saves": ["{install}/game/profile"],
  "folders": {
    "saves": [{ "path": "{install}/game/profile" }],
    "logs": [{ "path": "{install}/game/logs" }],
    "mods": [{ "path": "{install}/game/mods" }]
  },
  "settings": [
    {
      "id": "fps",
      "label": "Frame rate limit",
      "help": "The game runs at the same speed at any rate. 30 is the console's own. Display matches your screen's refresh rate.",
      "choices": [
        { "label": "30", "set": { "frame rate/fps_limit": "30" } },
        { "label": "60", "set": { "frame rate/fps_limit": "60" } },
        { "label": "120", "set": { "frame rate/fps_limit": "120" } },
        { "label": "144", "set": { "frame rate/fps_limit": "144" } },
        { "label": "Display", "set": { "frame rate/fps_limit": "display" } }
      ],
      "defaults": { "frame rate/fps_limit": "60" }
    },
    {
      "id": "window",
      "label": "Window",
      "help": "Fullscreen fills your screen. Windowed uses the game window.",
      "choices": [
        { "label": "Windowed", "set": { "display/fullscreen": "0" } },
        { "label": "Fullscreen", "set": { "display/fullscreen": "1" } }
      ],
      "defaults": { "display/fullscreen": "0" }
    },
    {
      "id": "resolution",
      "label": "Game resolution",
      "help": "The size the game draws its picture and interface in. 720p is the console's own. Higher sizes need more memory and a faster graphics card.",
      "choices": [
        { "label": "720p", "set": { "display/output_res": "1280x720" } },
        { "label": "1080p", "set": { "display/output_res": "1920x1080" } },
        { "label": "1440p", "set": { "display/output_res": "2560x1440" } }
      ],
      "defaults": { "display/output_res": "1280x720" }
    },
    {
      "id": "render_scale",
      "label": "3D render scale",
      "help": "How large the scene is drawn compared to the game resolution. Game's own follows the console's dynamic resolution.",
      "choices": [
        { "label": "Game's own", "set": { "display/render_scale": "game" } },
        { "label": "100%", "set": { "display/render_scale": "100" } },
        { "label": "75%", "set": { "display/render_scale": "75" } },
        { "label": "50%", "set": { "display/render_scale": "50" } }
      ],
      "defaults": { "display/render_scale": "game" }
    },
    {
      "id": "upscaler",
      "label": "AMD FSR upscaling",
      "help": "Draws at a lower render scale and sharpens the result back up to the game resolution. Works on any graphics card.",
      "choices": [
        { "label": "Off", "set": { "display/fsr3": "0" } },
        { "label": "On", "set": { "display/fsr3": "1" } }
      ],
      "defaults": { "display/fsr3": "0" }
    },
    {
      "id": "frame_gen",
      "label": "Frame generation",
      "help": "Adds a frame between two drawn ones, about doubling the frame rate you see. Needs FSR upscaling on, and works best with the frame rate limit at about half your screen's refresh rate.",
      "choices": [
        { "label": "Off", "set": { "display/frame_gen": "0" } },
        { "label": "On", "set": { "display/frame_gen": "1" } }
      ],
      "defaults": { "display/frame_gen": "0" },
      "when": { "display/fsr3": "1" }
    },
    {
      "id": "overlay",
      "label": "Performance overlay",
      "help": "The frame rate, or the frame rate with frame times, in the top right corner of the game. F10 switches it in the game.",
      "choices": [
        { "label": "Off", "set": { "display/perf_overlay": "off" } },
        { "label": "Frame rate", "set": { "display/perf_overlay": "fps" } },
        { "label": "Full", "set": { "display/perf_overlay": "full" } }
      ],
      "defaults": { "display/perf_overlay": "off" }
    }
  ],
  "actions": [
    { "id": "saves", "label": "Saves", "help": "Your save data.", "open": "saves" },
    { "id": "mods", "label": "Mods", "help": "The folder for your mods, one subfolder per mod.", "open": "mods" },
    { "id": "logs", "label": "Logs", "help": "The game's logs, to send with a bug report.", "open": "logs" }
  ]
}
