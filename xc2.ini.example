# xc2.ini: settings for xc2.exe. Copy this file to xc2.ini next to xc2.exe and remove the '#' of a line to change it.
# Each line shows the default; on a Steam Deck the device profile ([display]) changes a few of them. A XC2_*
# environment variable of the same name (XC2_FPS_LIMIT for fps_limit) overrides the file. Keys are case-insensitive;
# '#' and ';' start a comment; [sections] only group lines.

[frame rate]
# Frame rate limit: 30, 40, 45, 60, 90, 120, 144, any whole rate from 30 to 360, or display (the refresh rate of the
# window's monitor). The game steps the time each frame took, so it runs at the same speed at any rate. Changes while
# the game runs take effect at once.
# fps_limit = 120
# Older key, read only while fps_limit is unset: fps60 = 0 means a limit of 30.
# fps60 = 1
# Cutscenes and movies at 30 fps, as on the console (1), or at the limit (0). Read at start.
# cutscene_30 = 1
# realtime, cloth_realtime and highfps_fix are Xenoblade X settings and do nothing in XC2.

[performance]
# The keys of this section and of [diagnostics] are for testing and troubleshooting, and take effect at the next start.
# The Advanced tab of the settings menu (F1) shows all of them except zstd_native and zstd_check.

# Scheduling.
# A thread waiting for a virtual core interrupts the owner when it runs game code: 1 = on, 2 = priority inheritance
# without the interrupt, 0 = off (the old scheduling).
# async_preempt = 1
# Replay NVN submissions on their own thread, at most one frame behind the game (1 = on, 0 = off). Adds up to a frame of
# latency. Unset: on where the VRAM mirrors copy what the GPU reads at submit time, else off.
# replay_async = 1
# 1 (default) counts only presents toward the frame bound: the game queues a present once the replay thread has handled the
# one before it, at most one frame ahead. 0 counts texture releases too, so the bound stops holding after the first release
# and the game may run ahead by up to XC2_FLIGHT_MAX values (about three frames) and the replay queue. Takes effect after a restart.
# frame_bound = 1
# 1 lifts the virtual core gate: guest threads run without the console's limit of one thread per core, and core_float
# has no effect. The menu's Virtual core gate row shows the gate itself: On is free_cores = 0.
# free_cores = 0
# 1 lets the threads the game pins to virtual core 1 run on any of the three: still one thread per core. XC2 pins its
# job workers there, and they queue while the game streams an area in (leaving or entering a town). 1 cuts the slowdown
# when leaving Goldmouth's covered market from about 65 to 95 fps on an RTX 4070 Laptop. Takes effect after a restart.
# core_float = 1
# 1 (default): when a free virtual core could unblock a waiting thread, the holder of a core the waiter needs moves onto
# the free one. 0 leaves every holder in place, so a waiter waits for a release. A game that reads its processor number
# and keeps per-core state would see the move; this setting is for checking that. Takes effect after a restart.
# core_migrate = 1
# Windows timer resolution of 1 ms for steadier frame pacing (0 = the Windows default).
# timer_1ms = 1

# Shaders and pipelines.
# Draws whose pipeline is still building: default waits on a reserved worker; draw is the previous scheduling.
# pipe_wait = default
# Which draws are dropped instead of waiting for their pipeline: strict (only draws into per-frame passes), any (also
# draws into passes whose target the previous frame rendered) or fullscreen (those and full-screen draws).
# pipe_skip = fullscreen
# Build shader stage libraries in the background ahead of time, and the threads for it (1 to 16; default: a quarter of
# the CPU threads).
# lib_prebuild = 1
# lib_prebuild_threads = 4
# Build known pipelines ahead of time.
# pipe_prebuild = 1
# Threads that translate known shaders at start (1 to 64; default: half the CPU threads, at most 16).
# prewarm_xlate = 8
# Vulkan graphics pipeline library, 0 or 1. Default: on, except on AMD's driver for RDNA 1 and 2 (RX 5000 and 6000).
# gpl = 1

# Textures and memory.
# ASTC texture decoding: native (the GPU's own ASTC support), gpu (a compute shader), cpu, or auto (native when the GPU
# has it, gpu otherwise).
# astc = auto
# Game memory shared with the GPU: auto (mirror; import on an integrated GPU with less than 12 GB of system memory,
# and on Linux, which uses shadow storage), import (host memory imported into Vulkan: about 1.3 GiB less memory,
# but the frame guard stays on, about 25 % slower on an integrated GPU), mirror (pools used as buffers get a copy the
# GPU reads, filled at submit time) or verify (mirror plus a check of every copy; slow).
# memory = auto
# A new texture created over a live texture's memory starts with that content instead of empty.
# tex_alias = 1
# Host zstd decoder in place of the game's (0 = the game's), and a check that decodes every call both ways and logs
# the differences (1 = on; slow).
# zstd_native = 1
# zstd_check = 0

# Render fixes.
# Wait for the game to finish rewriting level-of-detail data before the GPU reads it: stops objects flashing in the
# wrong place and a flat far field for a frame.
# lod_guard = 1
# A draw that samples a target it also writes reads a copy made just before it, as on the Switch: stops the thin lines
# that flicker in the cloud sea on AMD GPUs. The copies cost about 0.1 ms a frame in the beginning-port save (RTX 4070
# Laptop). Some reporters found 0 cleared frame drops in Torna DLC scenes, and the cloud sea flicker may return on AMD.
# feedback_snap = 1
# How those copies are ordered against the rest of the frame: narrow (the default) orders only the copies' reads and
# writes; full uses the whole-frame barriers the copies had before, for comparison. Only matters while feedback_snap is 1.
# snap_sync = narrow
# Start each frame only once the GPU has drawn the one before it: stops props sliding and flickering above 30 fps.
# auto waits only where the GPU reads live game memory (memory = import, or a pool too large for the memory budget);
# otherwise the buffers it reads are copied at submit time and the GPU may run a frame behind. 1 always waits (about
# 25 % slower), 0 never.
# frame_guard = auto
# Fill the driver-reserved constant bank c0 (storage sizes, dispatch size, point size, base instance) instead of zeros.
# fix_c0 = 1
# New GPU memory pools start zero-filled, as Switch memory does.
# fix_zero = 1
# Optimisations, 0 turns each off: skip bindings that did not change, remember shader lookups, reuse the previous
# draw's pipeline when its state repeats, remember texture descriptors between draws, update descriptors in bulk,
# skip push constants that did not change.
# bind_skip = 1
# shader_memo = 1
# pipe_memo = 1
# tex_memo = 1
# desc_template = 1
# push_skip = 1
# Submit GPU work in parts every N draws between passes so the GPU starts earlier (0 to 1000; 0 = off), each part at
# least split_us microseconds long (0 to 20000).
# split_draws = 64
# split_us = 1000

# Vulkan.
# Vulkan validation layer: checks every call and slows the game down a lot. Needs the layer installed (Vulkan SDK).
# vk_validation = 0
# A thread of its own makes the Vulkan calls of each frame, 0 or 1. Default: on, except on AMD GPUs.
# vk_recorder = 1
# Dynamic vertex input, 0 or 1. Default: on, except on Intel's older integrated GPU drivers (Vulkan 1.3.215 and older).
# vk_dyn_vertex = 1
# Dynamic alpha to coverage, 0 or 1. Default: on, except on AMD's driver for RDNA 2 and older (RX 400 to RX 6000),
# which applies alpha to coverage while the dynamic state says off.
# vk_dyn_a2c = 1
# Pin the shader subgroup size to 32 when the GPU allows it.
# vk_subgroup_pin = 1

[display]
# Device profile: auto (the Steam Deck when this is one), desktop or deck. On a Steam Deck the keys this file does not
# set default to fullscreen = 1, window_size = 1280x800, output_res = 1280x720, render_scale = game, vk_present = fifo
# and fps_limit = 40 (starting points, not measured yet). Read at start.
# device_profile = auto
# Presentation mode: mailbox (default when the driver offers it, vsync otherwise), fifo (vsync) or immediate.
# vk_present = mailbox
# Window client area in pixels (640x360 to 7680x4320), and borderless fullscreen. F11 switches fullscreen and saves it
# here. Changes while the game runs take effect at once.
# window_size = 1920x1080
# fullscreen = 0
# Performance overlay in the top right corner: off, fps, or full (frame rate, mean and longest frame time). F10
# cycles the modes in game, as do both stick clicks (L3 + R3) on a controller.
# perf_overlay = off
# Which GPU to use: its index in the log, or part of its name. Default: the first discrete GPU with Vulkan 1.3.
# gpu_index = 0
# gpu_name = NVIDIA
# Game resolution: the size the game draws its picture and interface in (1280x720 to 7680x4320). Above 1280x720 the
# game's texture heap and memory pool grow with it. Read at start.
# output_res = 1280x720
# 3D render scale: the scene's size relative to the game resolution: game (its dynamic resolution) or a fixed
# percentage from 25 to 100; a higher one counts as 100. For supersampling, set output_res above window_size. Read at
# start.
# render_scale = game
# Scaling to the window when it is larger than the game resolution: fsr (AMD FSR 1) or bilinear, and FSR's sharpening
# from 0 (off) to 100. Changes while the game runs take effect at once.
# upscaler = fsr
# sharpness = 80
# AMD FSR in place of the game's temporal anti-aliasing and scaling, upscaling a lower render_scale to the game
# resolution: 1 on, 0 off. Needs amd_fidelityfx_loader_vk.dll (with amd_fidelityfx_upscaler_vk.dll) next to the game.
# Changes while the game runs take effect at once. To keep using OptiScaler instead of the built-in upscaler, remove
# amd_fidelityfx_loader_vk.dll: with no loader next to the game, the shim it installs as amd_fidelityfx_vk.dll is used.
# fsr3 = 0
# Which upscaler to ask AMD's library for: auto (the newest the GPU and driver support: FSR Upscaling 4.x on Radeon RX
# 6000 and newer with a recent driver, FSR 3.1 elsewhere), 4 or 3 to pin one. Changes take effect at once.
# fsr_version = auto
# AMD FSR Frame Generation: an interpolated frame between two drawn ones, so the display runs at about twice the frame
# rate. Needs fsr3 = 1, amd_fidelityfx_loader_vk.dll and amd_fidelityfx_framegeneration_vk.dll next to the game;
# sensible only with fps_limit at about half the display rate. Off by default. Changes take effect at once.
# frame_gen = 0
# Picture shape when the window's differs from the game resolution's (a 16:9 game on a 16:10 screen): keep (its
# proportions, with black bars) or stretch (over the whole window). Changes take effect at once.
# picture_fit = keep

[language]
# Language: a Windows locale such as de-DE, or a Switch code (en-US, ja, zh-Hant, ...). Default: the Windows locale.
# locale = en-US
# lang = en-US
# System mode reported to the game: docked or handheld.
# operation_mode = docked
# Language of the settings menu and the overlay: en or ru. Default: the Windows display language, English if it is
# neither.
# menu_lang = en

[audio]
# none mixes without opening an audio device.
# audio = default
# Audio the output queues before it starts, in ms (0 to 500).
# audio_prefill_ms = 20
# Volume in percent (0 to 100), on top of the game's own. Changes while the game runs take effect at once.
# volume = 100

[input]
# Gamepad motion controls (0 = off) and vibration (0 = off).
# motion = 1
# rumble = 1
# Rumble strength in percent (0 to 300; 0 = off) and the exponent on the amplitude (0.2 to 1.5; lower = weak pulses
# stronger, 1 = linear). rumble_triggers = 1 also drives the impulse triggers of an Xbox pad.
# rumble_strength = 130
# rumble_curve = 0.6
# rumble_triggers = 0
# Which gamepad button is Switch A: nintendo (by position: east A, south B, west Y, north X), xbox (south A, east B,
# west X, north Y, as an Xbox pad labels them; cross A on a PlayStation pad) or auto (nintendo for a pad with Nintendo
# labels, xbox for the others). The bind_ lines below apply on top. Changes while the game runs take effect at once.
# pad_layout = auto
# Button prompts the game draws: xbox, playstation, keyboard (the default keys), switch (the game's own) or auto (the
# connected gamepad's: playstation for a PlayStation pad, switch for a Nintendo one, xbox for the others; keyboard
# without a gamepad). The Xbox and PlayStation prompts follow pad_layout. The setup draws them from your game into
# prompts/ next to xc2.exe; the game reads them through its add-on content, or through an empty pack of the port's
# own when none is installed, which unlocks nothing. Takes effect at the next start.
# prompts = auto
# Gamepad stick dead zone in percent of full deflection (0 to 50). Raise it for a stick that drifts: inside the circle
# the stick reads centred, and the rest of its travel is scaled to start there.
# stick_deadzone = 8
# The dead zone of one stick, in place of stick_deadzone for that stick (0 to 50; unset = stick_deadzone). The Controls
# tab shows each stick's deflection now, so a drifting stick's resting value can be read off.
# lstick_deadzone = 8
# rstick_deadzone = 8
# Mouse camera sensitivity (0 to 10; 0 = no mouse camera and no cursor capture).
# mouse_sens = 1
# The keyboard's sticks are all or nothing, so the game only sees a full tilt from them; while this key is held the
# keyboard-driven stick values shrink and the keyboard can walk instead of run. Key names as in the bind_ lines below,
# none (the default) turns it off. walk_scale is 0.2 to 0.9; the default stops just above half because a keyboard
# sample of 32767 times 0.5 is one short of the 16384 the game's stick-direction bits need. Only the keyboard is
# scaled: the mouse camera and the gamepad are unchanged. The Controls tab sets both.
# walk_key = lalt
# walk_scale = 0.51
# Write the input of this run to a file that replays as a script (docs/controls.md, "Scripted input"). Default: off.
# input_record = input.txt
# Remap buttons: the Controls tab of the settings menu (F1) writes these lines. One line per Switch button or stick
# direction: bind_<A B X Y L R ZL ZR PLUS MINUS LEFT UP RIGHT DOWN LCLICK RCLICK> or bind_<LSTICK RSTICK>_<LEFT UP RIGHT
# DOWN> = comma separated pad:<name> and key:<name> entries, key:default / pad:default for that part's defaults, or none.
# A line replaces that button's defaults (pad and keyboard); buttons without a line keep them. Stick directions take keys
# only. Invalid entries are logged and skipped. Changes while the game runs take effect at once.
#   pad names: south east west north l r zl zr start back lstick rstick dpad_left dpad_up dpad_right dpad_down
#   lpaddle1 rpaddle1 lpaddle2 rpaddle2 (the back buttons of an Xbox Elite, DualSense Edge or Steam Controller)
#   key names: a-z 0-9 f2-f7 f9 f12 num0-num9 space tab enter backspace lshift rshift lctrl rctrl lalt capslock insert
#   delete home end pageup pagedown up down left right num_add num_sub num_mul num_div num_decimal minus equals
#   lbracket rbracket semicolon apostrophe comma period slash backslash grave mouse_l mouse_r mouse_m mouse_x1 mouse_x2
# Defaults (pad_layout = nintendo): A = pad:east, key:E. B = pad:south, key:lshift. X = pad:north, key:space.
# Y = pad:west, key:mouse_l. A pad that reports A/B and X/Y swapped (some GuliKit models): set pad_layout = xbox, or
# swap them back here (keyboard keys stay):
# bind_A = pad:south, key:E
# bind_B = pad:east, key:lshift
# bind_X = pad:west, key:space
# bind_Y = pad:north, key:mouse_l

[files]
# Folder with RomFS mod files that replace or add game files, listed in its manifest.tsv. Players put their mods into
# the mods folder instead ([mods]). Default: none.
# romfs_mods =

[mods]
# Folder with the player's mods, one subfolder per mod, unpacked as emulators take them: <name>/romfs, <name>/exefs
# (.ips, .pchtxt), <name>/cheats (<build id>.txt), or an SD card mod's atmosphere folder. An add-on content title's
# romfs (atmosphere/contents/0100E950040390NN/romfs) goes over that pack: XC2 mods replace archived files (bf2.arh)
# that way. Code patches and code cheats are built in by the setup. Default: mods next to xc2.exe.
# mods_dir =
# Load order, top first, names separated by |. The in-game menu (Mods) writes it; a mod not listed goes to the bottom.
# mods_order =
# Mods switched off, names separated by |.
# mods_disabled =

[cheats]
# One line per cheat of the mods' cheat files; the Cheats tab of the menu writes them. cheat_<hash> = 1 switches a
# cheat on, the hash being FNV-1a 32 of "<mod folder>/<cheat name>". Default: every cheat off.
# cheat_0123abcd = 1
# The port's own cheats, the Cheats tab's built-in rows (only in builds whose patch file has them):
# cheat_god_mode = 1       # enemy attacks land for 0
# cheat_insta_kill = 1     # the party's hits land for 9999

[diagnostics]
# Extra lines in the log, comma separated: svc, host, ipc, fs, gfx, perf, sched, audio, present or all. The menu's
# Performance log sets perf (frame timings). Default: none.
# trace = perf
# Flight recorder: keeps the last frames and saves them to a flight folder next to the folder of xc2.exe when a frame
# takes longer than flight_spike_ms (0 to 60000).
# flight = 0
# flight_spike_ms = 100
